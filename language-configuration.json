{
  "comments": {
    "lineComment": ";;"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[^\\s;\\[\\]{}()\"]+",
  "indentationRules": {
    "increaseIndentPattern": "^.*[{(\\[]\\s*(;;.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\])]"
  },
  "folding": {
    "markers": {
      "start": "^\\s*;;\\s*#region\\b",
      "end": "^\\s*;;\\s*#endregion\\b"
    }
  }
}
